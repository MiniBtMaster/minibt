{
  "name": "minibt-charts",
  "displayName": "MiniBT Charts",
  "description": "在 VS Code 编辑器页里运行并查看 MiniBT 策略图表（pylightcharts / bokeh，回测 / 回放 / 实时），以及打开 minibt desk 看盘终端。",
  "version": "0.3.11",
  "publisher": "MiniBtMaster",
  "author": {
    "name": "owen",
    "email": "407841129@qq.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "minibt",
    "quant",
    "trading",
    "backtest",
    "chart",
    "pylightcharts",
    "bokeh",
    "kline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MiniBtMaster/minibt-charts.git"
  },
  "bugs": {
    "url": "https://github.com/MiniBtMaster/minibt-charts/issues"
  },
  "homepage": "https://github.com/MiniBtMaster/minibt-charts#readme",
  "icon": "media/icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "minibt.runInEditor",
        "title": "在编辑器页运行策略图表",
        "category": "MiniBT",
        "icon": {
          "light": "media/run-light.svg",
          "dark": "media/run-dark.svg"
        }
      },
      {
        "command": "minibt.showLog",
        "title": "显示策略日志（带进度）",
        "category": "MiniBT",
        "icon": "$(output)"
      },
      {
        "command": "minibt.reloadChart",
        "title": "刷新图表",
        "category": "MiniBT",
        "icon": "$(refresh)"
      },
      {
        "command": "minibt.stopChart",
        "title": "停止策略进程",
        "category": "MiniBT",
        "icon": "$(debug-stop)"
      },
      {
        "command": "minibt.openInBrowser",
        "title": "在浏览器中打开图表",
        "category": "MiniBT",
        "icon": "$(link-external)"
      },
      {
        "command": "minibt.showOutput",
        "title": "显示策略输出（原始日志）",
        "category": "MiniBT"
      },
      {
        "command": "minibt.openDesk",
        "title": "打开 MiniBT 看盘终端",
        "category": "MiniBT",
        "icon": {
          "light": "media/desk-light.svg",
          "dark": "media/desk-dark.svg"
        }
      },
      {
        "command": "minibt.stopDesk",
        "title": "停止看盘终端",
        "category": "MiniBT",
        "icon": "$(debug-stop)"
      },
      {
        "command": "minibt.showDeskOutput",
        "title": "显示看盘终端日志",
        "category": "MiniBT",
        "icon": "$(output)"
      },
      {
        "command": "minibt.desk.setPassword",
        "title": "设置天勤密码（加密存储）",
        "category": "MiniBT",
        "icon": "$(key)"
      },
      {
        "command": "minibt.desk.clearPassword",
        "title": "清除已保存的天勤密码",
        "category": "MiniBT"
      }
    ],
    "keybindings": [
      {
        "command": "minibt.runInEditor",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == python"
      },
      {
        "command": "minibt.runInEditor",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == python"
      },
      {
        "command": "minibt.showLog",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorLangId == python"
      },
      {
        "command": "minibt.stopChart",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "activeWebviewPanelId == 'minibtChart'"
      },
      {
        "command": "minibt.openDesk",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "minibt.stopDesk",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d",
        "when": "minibt.deskOpen"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "minibt.runInEditor",
          "group": "navigation"
        },
        {
          "command": "minibt.showLog",
          "when": "minibt.chartOpen",
          "group": "navigation"
        },
        {
          "command": "minibt.reloadChart",
          "when": "minibt.chartOpen",
          "group": "navigation"
        },
        {
          "command": "minibt.stopChart",
          "when": "minibt.chartOpen",
          "group": "navigation"
        },
        {
          "command": "minibt.openDesk",
          "group": "navigation@2",
          "when": "!minibt.deskOpen"
        },
        {
          "command": "minibt.stopDesk",
          "group": "navigation@2",
          "when": "minibt.deskOpen"
        }
      ],
      "commandPalette": [
        {
          "command": "minibt.reloadChart",
          "when": "minibt.chartOpen"
        },
        {
          "command": "minibt.stopChart",
          "when": "minibt.chartOpen"
        },
        {
          "command": "minibt.openInBrowser",
          "when": "minibt.chartOpen"
        },
        {
          "command": "minibt.stopDesk",
          "when": "minibt.deskOpen"
        },
        {
          "command": "minibt.showDeskOutput",
          "when": "minibt.deskOpen"
        }
      ]
    },
    "configuration": {
      "title": "MiniBT Charts",
      "properties": {
        "minibt.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "运行策略用的 Python 解释器（需要它的环境里装了 minibt）。"
        },
        "minibt.engine": {
          "type": "string",
          "enum": [
            "auto",
            "pylightcharts",
            "bokeh"
          ],
          "enumDescriptions": [
            "跟随策略里写的 gui：Gui.Bokeh → bokeh；Gui.Pylightcharts / Gui.PylightchartsWeb / 没写 → pylightcharts 网页版（推荐）",
            "强制 pylightcharts 网页版",
            "强制 bokeh"
          ],
          "default": "auto",
          "description": "图表引擎。auto 跟随策略；纯 pylightcharts 原生窗口无法嵌入 VS Code，会被换成同一渲染器的网页版。"
        },
        "minibt.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "图表本地服务端口；0 = 自动挑一个空闲端口（推荐）。"
        },
        "minibt.cwd": {
          "type": "string",
          "default": "",
          "description": "策略的工作目录（用于相对路径取数据）；留空 = 工作区根目录。"
        },
        "minibt.extraPythonArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "附加给 Python 的参数，例如 [\"-X\", \"faulthandler\"]。"
        },
        "minibt.openBrowser": {
          "type": "boolean",
          "default": false,
          "description": "是否额外用系统浏览器打开图表（默认只在编辑器页里显示）。"
        },
        "minibt.openLog": {
          "type": "boolean",
          "default": true,
          "description": "运行时自动打开「MiniBT 策略日志」页签（带进度条）。"
        },
        "minibt.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "图表/日志在代码右侧单独开一列（左右分屏）。默认关闭：与代码在同一页签组内按标签切换，不会把页面拆成左右两半。"
        },
        "minibt.keepAliveOnClose": {
          "type": "boolean",
          "default": false,
          "description": "关闭图表页签时是否保留策略进程（默认关闭页签即停止）。"
        },
        "minibt.desk.account": {
          "type": "string",
          "default": "",
          "markdownDescription": "天勤账号（快期）。留空 = **不连期货**，只连股票。密码不要写在这里，用命令「MiniBT: 设置天勤密码」存进加密存储。"
        },
        "minibt.desk.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "天勤密码（**明文兜底**，仅在拿不到加密存储/环境变量 `MINIBT_TQ_PASSWORD` 时使用）。推荐：命令「MiniBT: 设置天勤密码」。"
        },
        "minibt.desk.futuHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "FutuOpenD 地址（股票）。默认 127.0.0.1，Futu 客户端另设了地址才需要改。"
        },
        "minibt.desk.futuPort": {
          "type": "number",
          "default": 11111,
          "minimum": 1,
          "maximum": 65535,
          "description": "FutuOpenD 端口（股票）。默认 11111。"
        },
        "minibt.desk.stocks": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "自动：检测到 FutuOpenD 就连股票",
            "总是尝试连股票",
            "不连股票（只看期货）"
          ],
          "default": "auto",
          "description": "股票（Futu）连接策略。"
        },
        "minibt.desk.offline": {
          "type": "boolean",
          "default": false,
          "description": "离线演示（不连任何网关，只看界面 / 演示数据）。"
        },
        "minibt.desk.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "跟随 VS Code 配色",
            "深色",
            "浅色"
          ],
          "default": "auto",
          "description": "看盘终端配色。"
        },
        "minibt.desk.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "打开工作区就自动启动看盘终端（会常驻一个 Python 进程）。"
        },
        "minibt.desk.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "看盘终端本地服务端口；0 = 自动挑一个空闲端口（推荐）。"
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "vsix": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish",
    "publish:ovsx": "npx --yes ovsx publish",
    "ls": "npx --yes @vscode/vsce ls"
  }
}
