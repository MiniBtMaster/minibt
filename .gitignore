# ============================================================================
# minibt —— GitHub 仓库忽略规则（.gitignore）
#
# 结构：仓库根 = 本目录（README / pyproject / setup.py / MANIFEST.in / …）
#       Python 包 = minibt/（__init__.py / desk / strategy / data / …）
#       教程 = tutorials/
#
# ⚠ 1. 行尾**不能写注释**：`*.c  # xxx` 会被当成"带注释的完整通配符"→ 永远
#      匹配不上（实测踩过 ✗）；注释一律单独占一行。
#   2. 只对**未跟踪**文件生效；已提交的要 `git rm -r --cached <路径>`。
#   3. 想让某个文件一定被上传：`git check-ignore -v <路径>` 确认没被吃掉。
#   4. 行尾 / 二进制规则在 `.gitattributes` 里配，不要混进这个文件。
# ============================================================================

# ===== Python 字节码 / 缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ===== 构建产物（wheel / sdist / egg-info 一律不入库）=====
build/
dist/
*.egg-info/
*.egg
.eggs/
wheelhouse/
pip-wheel-metadata/
*.whl
*.tar.gz

# ===== Cython 生成 / 编译产物 =====
*.pyd
*.so
*.dylib
*.dll
*.lib
*.obj
*.exp
# cythonize 从 .pyx 生成，不入库
*.c

# 回测 / 因子报告等运行时生成（tutorials/**/reports/*.html 也靠它）
*.html

# ===== 虚拟环境 / 工具缓存 =====
.venv/
.venv-*/
venv/
env/
.tox/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/
# mkdocs build 输出
site/
docs/_build/

# ===== minibt 运行时数据（不随仓库分发）=====
minibt/logs/
minibt/strategy/plots/
minibt/strategy/analysis_reports/
minibt/op_params/*.csv
# 运行时生成的实例 id（minibt/liveplot/ 已于 1.2.9 删除）
minibt/id
minibt/strategy/backtest_result.json
minibt/strategy/setting.json
# desk 的个人配置 / 状态（正常落在 ~/.minibt，万一被拷进仓库也别传）
desk_personal.json
tv_groups.json
tv_state.json
# ★ 登录信息（含**明文密码**！只应存在 ~/.minibt，绝不能被拷进仓库上传）
desk_login.json
desk_user_prefs.json
desk_user_prefs*.json
minibt/desk/*.log
minibt/desk/*.db
*.log
*.pid
*.stackdump

# ===== 敏感文件：账号 / 密钥 / 实盘脚本（即使现在没有，也先挡住）=====
.env
.env.*
*.pem
*.key
*_secret*
# 带天勤账号的调试脚本（**只在仓库根**，不要影响 tutorials/ 里的示例）
/77*.py
# 带账号的旧示例（同上，只在仓库根）
/cci*.py
# 实盘脚本（同上；tutorials/ 里的 *live*.py 账号都是从命令行 / 环境变量取，可上传）
/*_live_*.py
# 运行时账户状态（任何位置）
account_info*
trade_datas*
minibt/account_info*
minibt/trade_datas*

# ===== 临时文件 / 备份 / 补丁残留 =====
_tmp_*
_diag_*.py
# 根目录的临时说明文档（API_xxx.md 之类，不是正式文档）
API_*.md
*.tmp
*.bak
*.orig
*.rej
*~

# ===== 兄弟仓库（各自独立仓库，绝不能混进本仓库）=====
# ⚠ `tutorials/` 是**本仓库**的教程，不要加到下面
#    （`..` 开头的模式 git 不认，兄弟仓库在仓库外，天然不会被扫到 ✓）
minibt_docs/
miniqt/
pylightcharts/
vscode-minibt/
minibt-strategy/
tradingview/
design/
app/

# ===== AI 技能 / Agent 生成的目录（跑 `npx skills add` 会建）=====
.agents/
.claude/
.codex/
.cursor/
.aider*/
.continue/

# ===== 运行库 / 数据库（desk 审计库等，落在 ~/.minibt 才对）=====
*.sqlite3
minibt/*.sqlite3
minibt/desk/*.sqlite3

# ===== 扩展包（vsix 是产物，走 Release 不发仓库）=====
*.vsix

# ===== 教程里的运行产物（报告 / 图 / 日志）=====
# `*.html` 已全局忽略（生成的报告）；这里把目录也挡住，
# 免得以后 reports/ 里多出 csv / png 又被误提交 ✗
tutorials/**/reports/

# ===== 补充兜底（2026-11-22 复核补）=====
# 本地数据库 / 日志（desk 审计库、调度器输出等；正常都落在 ~/.minibt）
*.sqlite
minibt/*.db
minibt/*.sqlite
logs/
# 前端构建（本仓库目前没有 jslib，未来加也不用改规则）
node_modules/
# 其它 Python 构建残留
.python-version
*.egg

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
