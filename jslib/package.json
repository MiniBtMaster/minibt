{
  "name": "pylightcharts-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript bridge + drawing plugins bundled for the pylightcharts Python package.",
  "scripts": {
    "build": "rollup -c && node scripts/postbuild.mjs",
    "watch": "rollup -c -w",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror-languageserver": "^1.22.1",
    "lightweight-charts": "5.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.40.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
