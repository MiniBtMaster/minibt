# sdist 清单：只收录构建/安装真正需要的文件
include LICENSE
include README.md
include pyproject.toml
include setup.py
include requirements.txt
include requirements-lock.txt
include CHANGELOG.md
include RELEASE_NOTES.md
include RELEASING.md

# ---- 随包分发的资源（项目根 == minibt/，所以路径不带 minibt/ 前缀）----
recursive-include data *.csv *.ini *.png
recursive-include strategy *.js

# ---- Cython 源码（从 sdist 安装时需要用它现场编译）----
recursive-include cython_functions *.pyx
recursive-include zigzag *.pyx

# ---- 排除运行时 / 生成 / 中间产物 ----
prune build
prune cython_functions/build
recursive-exclude logs *
recursive-exclude strategy/plots *
recursive-exclude strategy/analysis_reports *
recursive-exclude op_params *
exclude strategy/setting.json
exclude strategy/backtest_result.json

# ---- 全局排除垃圾文件 ----
global-exclude *.py[cod]
global-exclude *.pyd *.so *.dylib
global-exclude *.c
global-exclude *.bak *.old *.orig *.rej
global-exclude *~
global-exclude "*.pyx.bak"
